# QuantMind configuration
QUANTMIND_API_KEY=
QUANTMIND_REQUIRE_AUTH=false
QUANTMIND_RATE_LIMIT_PER_MINUTE=60
QUANTMIND_MAX_ORDER_QUANTITY=10000
QUANTMIND_MAX_DAILY_LOSS_PCT=5
QUANTMIND_ALLOWED_PRODUCTS=CNC
QUANTMIND_AUDIT_DB_PATH=audit.db
QUANTMIND_AUTO_APPROVE=false
QUANTMIND_MAX_AGENT_TURNS=5

# Upstox
UPSTOX_API_KEY=
UPSTOX_ACCESS_TOKEN=
UPSTOX_ANALYTICS_TOKEN=

# OpenAI (optional; falls back to echo if not set)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
